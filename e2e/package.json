{
  "name": "keyjolt-e2e",
  "private": true,
  "description": "Playwright browser smoke tests for KeyJolt (kept apart from the Maven build).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:e2e": "node run-local.mjs",
    "test:e2e:url": "playwright test",
    "test:e2e:live": "KEYJOLT_LIVE=1 KEYJOLT_BASE_URL=${KEYJOLT_BASE_URL:-https://keyjolt.dev} playwright test",
    "screenshots": "KEYJOLT_SCREENSHOTS=1 node run-local.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
